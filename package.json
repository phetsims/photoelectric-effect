{
  "name": "photoelectric-effect",
  "version": "1.0.0-dev.0",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/phetsims/photoelectric-effect.git"
  },
  "devDependencies": {
    "grunt": "~1.5.3"
  },
  "phet": {
    "requirejsNamespace": "PHOTOELECTRIC_EFFECT",
    "phetLibs": [
      "bamboo"
    ],
    "simulation": true,
    "runnable": true,
    "supportedBrands": [
      "phet",
      "adapted-from-phet",
      "phet-io"
    ],
    "supportsOutputJS": true,
    "simFeatures": {
      "supportsDynamicLocale": true,
      "supportsInteractiveDescription": true
    },
    "screenNameKeys": [
      "PHOTOELECTRIC_EFFECT/screen.intro",
      "PHOTOELECTRIC_EFFECT/screen.experiment",
      "PHOTOELECTRIC_EFFECT/screen.energy"
    ]
  }
}